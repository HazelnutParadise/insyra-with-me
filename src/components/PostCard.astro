---
import { urlOf, readingTime, fmtDate, categoryOf, type Post } from '../lib/posts';
const { post } = Astro.props as { post: Post };
---
<li class="card">
  <p class="meta"><a class="cat" href={`/category/${post.data.category}/`}>{categoryOf(post.data.category).name}</a> · <time datetime={post.data.pubDate.toISOString()}>{fmtDate(post.data.pubDate)}</time> · {readingTime(post.body)} min read</p>
  <h3><a href={urlOf(post)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
</li>
<style>.cat { font-weight: 700; color: var(--link); text-decoration: none; text-transform: uppercase; letter-spacing: .06em; font-size: .78rem; }</style>
