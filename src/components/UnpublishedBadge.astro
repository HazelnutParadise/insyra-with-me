---
import { isUnpublishedOnProd, isUnpublishedPost, UNPUBLISHED_LABEL } from '../lib/preview';
import type { Post } from '../lib/posts';
interface Props { post?: Post; path?: string }
const { post, path } = Astro.props;
const show = post ? await isUnpublishedPost(post) : path ? await isUnpublishedOnProd(path) : false;
---
{show && <p class="preview-unpub">{UNPUBLISHED_LABEL}</p>}
<style>
  .preview-unpub {
    display: inline-block;
    width: fit-content;
    margin: 0 0 .45rem;
    padding: .2rem .55rem;
    background: #f6ab42;
    color: #1a1a1a;
    font-family: var(--font-sans);
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .02em;
    line-height: 1.3;
  }
</style>
