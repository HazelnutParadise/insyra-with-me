---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, tagSlug, type Post } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPosts(); const map = new Map<string, { name: string; posts: Post[] }>();
  for (const p of posts) for (const t of p.data.tags) { const s = tagSlug(t); if (!map.has(s)) map.set(s, { name: t, posts: [] }); map.get(s)!.posts.push(p); }
  return [...map].map(([tag, v]) => ({ params: { tag }, props: v }));
}
const { name, posts } = Astro.props as { name: string; posts: Post[] };
---
<Base title={`#${name}`} description={`Posts tagged ${name}.`}>
  <div class="wrap"><h1>#{name}</h1><ul class="card-list">{posts.map((p) => <PostCard post={p} />)}</ul></div>
</Base>
