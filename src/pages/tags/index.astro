---
import Base from '../../layouts/Base.astro';
import { getPosts, tagSlug } from '../../lib/posts';
const counts = new Map<string, number>();
for (const p of await getPosts()) for (const t of p.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tags = [...counts].sort((a, b) => a[0].localeCompare(b[0]));
---
<Base title="Tags" description="Browse posts by tag.">
  <div class="wrap"><h1>Tags</h1><p>{tags.map(([t, n]) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>#{t} ({n})</a>)}</p></div>
</Base>
