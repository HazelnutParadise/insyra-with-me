---
import { SITE } from '../../site.config';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
---
<Base title="All posts" description="All posts on Insyra With Me: Insyra guides and use cases, community stories, ecosystem projects, resources, events and release news.">
  <div class="wrap"><header class="page-head"><h1>All posts</h1><p class="meta">Guides, stories, ecosystem projects and news from around Insyra.</p></header>{posts.length ? <ul class="card-list">{posts.map((p) => <PostCard post={p} />)}</ul> : <p class="arrow-row">First posts are on the way. Meanwhile, <a class="arrow" href={SITE.links.docs}>read the Insyra docs ↗</a></p>}</div>
</Base>
