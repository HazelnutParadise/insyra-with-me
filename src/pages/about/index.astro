---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';
import { aboutCopy } from '../../content/about-copy';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'HazelnutParadise',
    url: SITE.org.url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: 'Insyra',
    codeRepository: SITE.links.github,
    programmingLanguage: 'Go',
    license: 'https://opensource.org/licenses/MIT',
    sameAs: [
      SITE.links.github,
      SITE.links.docs,
      SITE.links.site,
      'https://pkg.go.dev/github.com/HazelnutParadise/insyra',
    ],
  },
];
---
<Base title={aboutCopy.pageTitle} description={aboutCopy.description} jsonLd={jsonLd}>
  <div class="wrap">
    <header class="page-head">
      <h1>{aboutCopy.pageTitle}</h1>
      <p class="meta">{aboutCopy.description}</p>
    </header>
    <article class="prose about-page">
      <p class="placeholder-note">{aboutCopy.placeholderNotice}</p>
      <section>
        <h2>{aboutCopy.definitionTitle}</h2>
        {aboutCopy.definition.map((p) => <p>{p}</p>)}
      </section>
      <section>
        <h2>{aboutCopy.installTitle}</h2>
        <p>{aboutCopy.installIntro}</p>
        <pre class="plain-code"><code>{aboutCopy.installCommand}</code></pre>
      </section>
      <section>
        <h2>{aboutCopy.exampleTitle}</h2>
        <p>{aboutCopy.exampleIntro}</p>
        <pre class="plain-code" data-language="go"><code>{aboutCopy.exampleSource}</code></pre>
        <h3>Output</h3>
        <pre class="plain-code"><code>{aboutCopy.exampleOutput}</code></pre>
      </section>
      <section>
        <h2>{aboutCopy.linksTitle}</h2>
        <ul>
          {aboutCopy.links.map((l) => (
            <li><a href={l.href} rel="noopener">{l.label}</a></li>
          ))}
        </ul>
      </section>
    </article>
  </div>
</Base>
<style>
  .placeholder-note { color: var(--muted); font-size: .9rem; margin: 0 0 1.5rem; }
  .about-page pre.plain-code {
    overflow: auto;
    padding: 1rem 1.1rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    color: var(--text);
  }
  .about-page pre.plain-code code { font-family: var(--font-mono); font-size: .9rem; }
</style>
