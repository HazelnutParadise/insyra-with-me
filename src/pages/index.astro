---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, CATEGORIES } from '../lib/posts';
import { SITE, SITE_URL } from '../site.config';
const posts = (await getPosts()).slice(0, 6);
const ld = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE_URL + '/', description: SITE.description, inLanguage: 'en',
  about: { '@type': 'SoftwareSourceCode', name: 'Insyra', codeRepository: SITE.links.github, programmingLanguage: 'Go' },
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.org.name, url: SITE.org.url },
};
---
<Base jsonLd={ld}>
  <section class="hero">
    <svg class="geo" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect x="760" y="0" width="440" height="430" class="g-blue" />
      <rect x="980" y="430" width="220" height="270" class="g-orange" />
      <rect x="640" y="430" width="560" height="10" class="g-rule" />
      <rect x="640" y="452" width="340" height="2" class="g-rule" />
      <g class="g-dots">{Array.from({ length: 5 }, (_, r) => Array.from({ length: 9 }, (_, c) => <rect x={40 + c * 26} y={590 + r * 20} width="6" height="6" />))}</g>
    </svg>
    <div class="wrap hero-in">
      <div class="copy">
        <h1 class="brand-h1"><span>Insyra</span> <span class="with">With Me</span></h1>
        <p class="sub">{SITE.tagline}.</p>
        <p class="lead">The guide and community blog around <a href={SITE.links.site}>Insyra</a>, the data analysis library for Go: how-to guides and use cases, stories from people using it, ecosystem projects like Idensyra and Syralit, resources, events and release news.</p>
        <p class="cta"><a class="btn" href="/category/guides/">Browse the guides <span aria-hidden="true">→</span></a><a class="arrow" href={SITE.links.docs}>Read the docs <span aria-hidden="true">↗</span></a></p>
      </div>
      <div class="motif" aria-hidden="true">
        <div class="code-block">
          <p class="file">main.go</p>
<pre><b>names</b> := insyra.<em>NewDataList</em>(
    <s>"Alice"</s>, <s>"Bob"</s>, <s>"Charlie"</s>,
).<em>SetName</em>(<s>"Name"</s>)
<b>ages</b> := insyra.<em>NewDataList</em>(<u>28</u>, <u>34</u>, <u>29</u>).
    <em>SetName</em>(<s>"Age"</s>)

<b>dt</b> := insyra.<em>NewDataTable</em>(names, ages).
    <em>SetName</em>(<s>"Team Members"</s>)
insyra.<em>Show</em>(<s>"Preview"</s>, dt, <u>2</u>)</pre>
        </div>
        <div class="rule-table">
          <p class="t-title">Team Members</p>
          <table><thead><tr><th>Name</th><th>Age</th></tr></thead>
            <tbody><tr><td>Alice</td><td>28</td></tr><tr><td>Bob</td><td>34</td></tr><tr class="fade"><td>Charlie</td><td>29</td></tr></tbody></table>
        </div>
      </div>
    </div>
  </section>
  <section class="wrap">
    <h2 class="sec"><span>Explore by category</span></h2>
    <ol class="cat-grid">{CATEGORIES.map((c, i) => <li><a href={`/category/${c.slug}/`}><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><strong>{c.name}</strong><span class="b">{c.blurb}</span><span class="go" aria-hidden="true">→</span></a></li>)}</ol>
    <h2 class="sec"><span>Latest posts</span></h2>
    <ul class="card-list">{posts.map((p) => <PostCard post={p} />)}</ul>
    <p><a class="arrow" href="/posts/">All posts <span aria-hidden="true">→</span></a></p>
  </section>
</Base>
<style>
  .hero { --h-bg: var(--brand-cream); --h-text: var(--gray-20); --h-title: var(--brand-blue-logo);
    position: relative; overflow: hidden; background: var(--h-bg); color: var(--h-text); padding: clamp(2.5rem, 7vw, 5.5rem) 0 clamp(3rem, 6vw, 5rem); margin-bottom: 3rem; }
  @media (prefers-color-scheme: dark) { .hero { --h-bg: var(--gray-10); --h-text: var(--gray-88); --h-title: var(--white); } }
  .hero::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 10px; background: var(--brand-orange-logo); box-shadow: 0 -14px 0 -12px var(--brand-blue-logo); }
  .geo { position: absolute; inset: 0; width: 100%; height: 100%; }
  .g-blue { fill: var(--brand-blue-logo); } .g-orange { fill: var(--brand-orange-logo); } .g-rule { fill: var(--brand-blue-logo); }
  .g-dots rect { fill: var(--brand-blue); opacity: .45; }
  @media (prefers-color-scheme: dark) { .g-blue { fill: var(--brand-blue); opacity: .6; } .g-rule { fill: var(--brand-orange-logo); } .g-dots rect { fill: var(--brand-orange-logo); opacity: .35; } }
  @media (max-width: 900px) { .geo { opacity: .35; } }
  .hero-in { position: relative; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 2.5rem; align-items: end; }
  .brand-h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(3.4rem, 11vw, 9.5rem); line-height: .88; letter-spacing: -0.045em; margin: 0 0 1.4rem; color: var(--h-title); }
  .brand-h1 span { display: block; }
  .brand-h1 .with { display: inline-block; color: var(--gray-10); background: var(--brand-orange-logo); padding: 0 .12em .06em; margin-top: .06em; }
  .sub { font-family: var(--font-display); font-size: clamp(1.25rem, 2.4vw, 1.75rem); font-weight: 600; margin: 0 0 .8rem; color: var(--h-title); border-top: 4px solid var(--h-title); padding-top: .7rem; max-width: 26ch; }
  .lead { font-size: 1.08rem; max-width: 46ch; margin: 0 0 1.6rem; }
  .hero .lead a { color: var(--h-title); font-weight: 600; }
  .cta { display: flex; gap: 1.6rem; flex-wrap: wrap; align-items: center; margin: 0; }
  .btn { padding: .8rem 1.3rem; color: var(--white); background: var(--brand-blue-logo); text-decoration: none; font-weight: 700; }
  .btn:hover { background: var(--gray-10); }
  @media (prefers-color-scheme: dark) { .btn { background: var(--brand-orange-logo); color: var(--black); } .btn:hover { background: var(--white); } }
  .hero .arrow { color: var(--h-title); }
  .motif { position: relative; }
  .code-block { background: var(--gray-10); color: var(--gray-88); border-top: 8px solid var(--brand-orange-logo); }
  @media (prefers-color-scheme: dark) { .code-block { background: var(--black); } }
  .file { margin: 0; padding: .7rem 1.1rem 0; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-orange-logo); }
  .code-block pre { margin: 0; padding: .6rem 1.1rem 1.2rem; font-family: var(--font-mono); font-size: clamp(.66rem, 1vw, .82rem); line-height: 1.6; overflow-x: auto; white-space: pre; }
  .code-block b { color: var(--white); font-weight: 600; } .code-block em { font-style: normal; color: var(--brand-orange-logo); }
  .code-block s { text-decoration: none; color: var(--brand-cream); } .code-block u { text-decoration: none; color: var(--brand-orange-logo); }
  .rule-table { width: min(16rem, 80%); margin: 1.4rem 0 0 auto; color: var(--h-text); }
  .t-title { margin: 0 0 .3rem; font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--h-title); }
  .rule-table table { width: 100%; border-collapse: collapse; font-size: .92rem; background: var(--h-bg); }
  .rule-table th { text-align: left; padding: .35rem .2rem; border-top: 4px solid var(--h-title); border-bottom: 1px solid var(--h-title); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--h-title); }
  .rule-table td { padding: .35rem .2rem; border-bottom: 1px solid var(--gray-33); font-variant-numeric: tabular-nums; }
  .rule-table tr:last-child td { border-bottom: 4px solid var(--h-title); }
  .rule-table .fade td { color: var(--h-text); font-style: italic; }
  @media (max-width: 900px) { .hero-in { grid-template-columns: 1fr; } }
  .cat-grid { list-style: none; padding: 0; margin: 0 0 3.5rem; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0; }
  .cat-grid li:nth-child(1) { grid-column: span 3; grid-row: span 2; } .cat-grid li:nth-child(2) { grid-column: span 3; }
  .cat-grid li:nth-child(n+3) { grid-column: span 1; } .cat-grid li:nth-child(3) { grid-column: span 1; }
  .cat-grid li:nth-child(3), .cat-grid li:nth-child(4), .cat-grid li:nth-child(5) { grid-column: auto / span 1; }
  .cat-grid { grid-template-areas: none; }
  .cat-grid a { position: relative; display: flex; flex-direction: column; gap: .35rem; height: 100%; padding: 1.2rem 1.3rem 2.6rem; color: var(--text); text-decoration: none; background: var(--bg-soft); }
  .cat-grid li:nth-child(1) a { background: var(--brand-blue-logo); color: var(--white); padding-top: 1.6rem; }
  .cat-grid li:nth-child(2) a { background: var(--brand-orange-logo); color: var(--black); }
  .cat-grid li:nth-child(4) a { background: var(--surface); }
  .cat-grid .n { font-family: var(--font-display); font-weight: 700; font-size: 2.6rem; line-height: 1; letter-spacing: -0.03em; }
  .cat-grid li:nth-child(1) .n { font-size: clamp(4rem, 9vw, 7rem); }
  .cat-grid strong { font-family: var(--font-display); font-size: 1.15rem; } .cat-grid li:nth-child(1) strong { font-size: clamp(1.4rem, 2.6vw, 2rem); }
  .cat-grid .b { font-size: .9rem; } .cat-grid .go { position: absolute; right: 1.1rem; bottom: .8rem; font-size: 1.4rem; transition: transform .15s; }
  .cat-grid a:hover .go { transform: translateX(4px); } .cat-grid a:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  @media (min-width: 901px) { .cat-grid { grid-template-columns: 2fr 1fr 1fr 1fr; } .cat-grid li:nth-child(1) { grid-column: 1; grid-row: 1 / span 2; } .cat-grid li:nth-child(2) { grid-column: 2 / span 3; } .cat-grid li:nth-child(n+3) { grid-column: auto; } }
  @media (max-width: 900px) { .cat-grid { grid-template-columns: 1fr 1fr; } .cat-grid li:nth-child(1) { grid-column: 1 / -1; grid-row: auto; } .cat-grid li:nth-child(2) { grid-column: 1 / -1; } .cat-grid li:nth-child(n+3) { grid-column: auto; } .cat-grid li:nth-child(5) { grid-column: 1 / -1; } }
</style>
