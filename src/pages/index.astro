---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';
import { SITE, SITE_URL } from '../site.config';
const posts = (await getPosts()).slice(0, 5);
const ld = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE_URL + '/', description: SITE.description, inLanguage: 'en',
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.org.name, url: SITE.org.url },
};
---
<Base jsonLd={ld}>
  <section class="hero">
    <div class="wrap hero-in">
      <div>
        <p class="kicker">Insyra With Me</p>
        <h1>{SITE.tagline}</h1>
        <p class="lead">Notes and guides about <a href={SITE.links.site}>Insyra</a>, a data analysis library for Go, by the person who builds it.</p>
        <p class="cta"><a class="btn primary" href="/posts/">Read the posts</a><a class="btn" href={SITE.links.docs}>Insyra docs</a></p>
      </div>
      <img class="hero-logo" src="/logo-icon.png" alt="Insyra logo" width="200" height="200" />
    </div>
  </section>
  <section class="wrap">
    <h2>Latest posts</h2>
    <ul class="card-list">{posts.map((p) => <PostCard post={p} />)}</ul>
    <p><a href="/posts/">All posts →</a></p>
  </section>
</Base>
<style>
  .hero { background: var(--hero-bg); color: var(--hero-text); padding: 3.5rem 0; margin-bottom: 2rem; border-bottom: 6px solid var(--accent); }
  .hero a { color: var(--brand-orange-logo); }
  .hero-in { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .kicker { text-transform: uppercase; letter-spacing: .15em; font-weight: 700; color: var(--brand-orange-logo); margin: 0; font-size: .85rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin: .4rem 0 1rem; max-width: 20ch; }
  .lead { font-size: 1.15rem; max-width: 46ch; }
  .cta { display: flex; gap: .8rem; flex-wrap: wrap; }
  .btn { padding: .6rem 1.1rem; border-radius: 8px; border: 2px solid var(--brand-orange-logo); color: var(--white) !important; text-decoration: none; font-weight: 600; }
  .btn.primary { background: var(--brand-orange-logo); color: var(--black) !important; }
  .hero-logo { background: var(--white); border-radius: 24px; padding: 1rem; width: 180px; height: auto; }
  @media (max-width: 700px) { .hero-logo { display: none; } }
</style>
