---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts, activeCategories, urlOf, fmtDate, readingTime, categoryOf } from '../lib/posts';
import { SITE, SITE_URL } from '../site.config';
const posts = (await getPosts()).slice(0, 6);
const cats = await activeCategories();
const n2 = (i: number) => String(i + 1).padStart(2, '0');
const ld = {
  '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE_URL + '/', description: SITE.description, inLanguage: 'en',
  about: { '@type': 'SoftwareSourceCode', name: 'Insyra', codeRepository: SITE.links.github, programmingLanguage: 'Go' },
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Organization', name: SITE.org.name, url: SITE.org.url },
};
---
<Base jsonLd={ld}>
  <section class="hero">
    <svg class="geo" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <rect x="760" y="0" width="440" height="430" class="g-blue" />
      <rect x="980" y="430" width="220" height="270" class="g-orange" />
      <g class="g-dots">{Array.from({ length: 5 }, (_, r) => Array.from({ length: 9 }, (_, c) => <rect x={40 + c * 26} y={590 + r * 20} width="6" height="6" />))}</g>
    </svg>
    <div class="wrap hero-in">
      <div class="copy">
        <h1 class="brand-h1"><span>Insyra</span> <span class="with">With Me</span></h1>
        <p class="sub">{SITE.tagline}.</p>
        <p class="lead">The guide and community blog around <a href={SITE.links.site}>Insyra</a>, the data analysis library for Go: how-to guides and use cases, stories from people using it, ecosystem projects like Syralit, resources, events and release news.</p>
        <p class="cta"><a class="btn" href="/posts/">Read the latest <span aria-hidden="true">→</span></a><a class="btn btn-alt" href={SITE.links.site} target="_blank" rel="noopener">Visit Insyra <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></p>
      </div>
      <div class="motif">
        <div class="code-block" id="egg">
          <p class="file"><span>main.go</span><button type="button" class="hint" id="egg-btn" aria-pressed="false">Click or press Enter to run</button></p>
<pre><span class="ln" style="--i:0"><b>steps</b> := insyra.<em>NewDataList</em>(<s>"Created"</s>, <s>"v0.1.0"</s>).</span><span class="ln" style="--i:1">    <em>SetName</em>(<s>"Milestone"</s>)</span><span class="ln" style="--i:2"><b>dates</b> := insyra.<em>NewDataList</em>(<s>"2024-08-29"</s>, <s>"2025-02-10"</s>).</span><span class="ln" style="--i:3">    <em>SetName</em>(<s>"Date"</s>)</span><span class="ln" style="--i:4"><b>dt</b> := insyra.<em>NewDataTable</em>(steps, dates).</span><span class="ln" style="--i:5">    <em>SetName</em>(<s>"Insyra Milestones"</s>)</span><span class="ln" style="--i:6"> </span><span class="ln" style="--i:7">dt.<em>AppendRowsByColName</em>(<b>map</b>[<b>string</b>]<b>any</b>&#123;</span><span class="ln" style="--i:8">    <s>"Milestone"</s>: <s>"v0.2.0"</s>, <s>"Date"</s>: <s>"2025-05-30"</s>,</span><span class="ln" style="--i:9">&#125;)</span><span class="ln" style="--i:10">fmt.<em>Println</em>(<s>"Insyra With Me: since"</s>, dates.<em>Get</em>(<u>0</u>))</span></pre>
          <p class="out"><span class="prompt" aria-hidden="true">$ go run .</span> <span class="res" data-res="Insyra With Me: since 2024-08-29">// ready when you are</span></p>
        </div>
        <div class="rule-table" aria-hidden="true">
          <p class="t-title">Insyra Milestones</p>
          <table><thead><tr><th>Milestone</th><th>Date</th></tr></thead><tbody><tr><td>Created</td><td>2024-08-29</td></tr><tr><td>v0.1.0</td><td>2025-02-10</td></tr><tr class="you"><td>v0.2.0</td><td>2025-05-30</td></tr></tbody></table>
        </div>
        <p class="sr-only" aria-live="polite" id="egg-live"></p>
      </div>
    </div>
  </section>
  <section class="wrap">
    {cats.length > 0 && <>
      <h2 class="sec"><span>Explore by category</span></h2>
      <ol class="cat-grid" data-n={Math.min(cats.length, 5)}>{cats.map((c, i) => <li><a href={`/category/${c.slug}/`}><span class="n" aria-hidden="true">{n2(i)}</span><strong>{c.name}</strong><span class="b">{c.blurb}</span><span class="go" aria-hidden="true">→</span></a></li>)}</ol>
    </>}
    <h2 class="sec"><span>{posts.length === 1 ? 'The first post' : 'Latest posts'}</span></h2>
    {posts.length === 0 && (
      <div class="soon">
        <p class="soon-k">00</p>
        <div><p class="soon-t">First posts are on the way.</p>
          <p>Guides, community stories and release notes will land here. Until then, the docs and the source are the best place to start.</p>
          <p class="soon-links"><a class="arrow" href={SITE.links.docs}>Read the Insyra docs <span aria-hidden="true">↗</span></a><a class="arrow" href={SITE.links.github}>Insyra on GitHub <span aria-hidden="true">↗</span></a></p></div>
      </div>)}
    {(posts.length === 1 || posts.length === 2) && (
      <ol class={`feat feat-${posts.length}`}>{posts.map((p, i) => (
        <li><span class="fn" aria-hidden="true">{n2(i)}</span>
          <div><p class="meta"><a class="cat" href={`/category/${p.data.category}/`}>{categoryOf(p.data.category).name}</a> · <time datetime={p.data.pubDate.toISOString()}>{fmtDate(p.data.pubDate)}</time> · {readingTime(p.body)} min read</p>
          <h3><a href={urlOf(p)}>{p.data.title}</a></h3><p class="fd">{p.data.description}</p>
          <p><a class="arrow" href={urlOf(p)} aria-hidden="true" tabindex="-1">Read <span>→</span></a></p></div></li>))}</ol>)}
    {posts.length >= 3 && <ul class="card-list">{posts.map((p) => <PostCard post={p} />)}</ul>}
    {posts.length > 0 && <p><a class="arrow" href="/posts/">All posts <span aria-hidden="true">→</span></a></p>}
  </section>
  <script is:inline>
(() => { const b = document.getElementById('egg'); if (!b) return;
  const live = document.getElementById('egg-live'), res = b.querySelector('.res'), idle = res.textContent, m = b.closest('.motif');
  const btn = document.getElementById('egg-btn'); const rm = matchMedia('(prefers-reduced-motion: reduce)'); let t;
  const set = (s) => { m.dataset.egg = s; btn.setAttribute('aria-pressed', s === 'idle' ? 'false' : 'true'); };
  const done = () => { set('done'); res.textContent = res.dataset.res; live.textContent = 'Ran main.go. Output: ' + res.dataset.res + '. A row for v0.2.0, 2025-05-30, was added to the table.'; };
  const go = () => { clearTimeout(t);
    if (m.dataset.egg && m.dataset.egg !== 'idle') { set('idle'); res.textContent = idle; live.textContent = 'Example reset.'; return; }
    if (rm.matches) return done();
    set('running'); res.textContent = '…'; t = setTimeout(done, b.querySelectorAll('.ln').length * 140 + 400); };
  b.addEventListener('click', go);
})();
  </script>
</Base>
<style>
  .hero { --h-bg: var(--brand-cream); --h-text: var(--gray-20); --h-title: var(--brand-blue-logo);
    position: relative; overflow: hidden; background: var(--h-bg); color: var(--h-text); padding: clamp(2.5rem, 7vw, 5.5rem) 0 clamp(3rem, 6vw, 5rem); margin-bottom: 3rem; }
  @media (prefers-color-scheme: dark) { .hero { --h-bg: var(--gray-10); --h-text: var(--gray-88); --h-title: var(--white); } }
  .hero::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 10px; background: var(--brand-orange-logo); box-shadow: 0 -14px 0 -12px var(--brand-blue-logo); }
  .geo { position: absolute; inset: 0; width: 100%; height: 100%; }
  .g-blue { fill: var(--brand-blue-logo); } .g-orange { fill: var(--brand-orange-logo); } .g-rule { fill: var(--brand-blue-logo); }
  .g-dots rect { fill: var(--brand-blue); opacity: .45; }
  @media (prefers-color-scheme: dark) { .g-blue { fill: var(--brand-blue); opacity: .6; } .g-rule { fill: var(--brand-orange-logo); } .g-dots rect { fill: var(--brand-orange-logo); opacity: .35; } }
  @media (max-width: 900px) { .geo { opacity: .35; } }
  .hero-in { position: relative; display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 2.5rem; align-items: end; }
  .brand-h1 { font-family: var(--font-display); font-weight: 700; font-size: clamp(3.4rem, 11vw, 9.5rem); line-height: .88; letter-spacing: -0.045em; margin: 0 0 1.4rem; color: var(--h-title); }
  .brand-h1 span { display: block; }
  .brand-h1 .with { display: inline-block; color: var(--gray-10); background: var(--brand-orange-logo); padding: 0 .12em .06em; margin-top: .06em; }
  .sub { font-family: var(--font-display); font-size: clamp(1.25rem, 2.4vw, 1.75rem); font-weight: 600; margin: 0 0 .8rem; color: var(--h-title); border-top: 4px solid var(--h-title); padding-top: .7rem; max-width: 26ch; }
  .lead { font-size: 1.08rem; max-width: 46ch; margin: 0 0 1.6rem; }
  .hero .lead a { color: var(--h-title); font-weight: 600; }
  .cta { display: flex; gap: .8rem; flex-wrap: wrap; align-items: center; margin: 0; }
  .btn { display: inline-flex; align-items: center; gap: .5rem; min-height: 48px; padding: .8rem 1.4rem; color: var(--white); background: var(--brand-blue-logo); text-decoration: none; font-weight: 700; }
  .btn-alt { color: var(--black); background: var(--brand-orange-logo); }
  .btn:hover { background: var(--gray-10); color: var(--white); }
  .btn:focus-visible { outline: 3px solid var(--gray-10); outline-offset: 3px; }
  @media (prefers-color-scheme: dark) { .btn:hover { background: var(--white); color: var(--black); } .btn:focus-visible { outline-color: var(--white); } }
  @media (max-width: 520px) { .cta .btn { flex: 1 1 100%; justify-content: center; } }
  .motif { position: relative; }
  .code-block { background: var(--gray-10); color: var(--gray-88); border-top: 8px solid var(--brand-orange-logo); }
  @media (prefers-color-scheme: dark) { .code-block { background: var(--black); } }
  .file { margin: 0; padding: .7rem 1.1rem 0; font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--brand-orange-logo); }
  .code-block pre { margin: 0; padding: .6rem 1.1rem 1.2rem; font-family: var(--font-mono); font-size: clamp(.66rem, 1vw, .82rem); line-height: 1.6; overflow-x: auto; white-space: pre; }
  .code-block b { color: var(--white); font-weight: 600; } .code-block em { font-style: normal; color: var(--brand-orange-logo); }
  .code-block s { text-decoration: none; color: var(--brand-cream); } .code-block u { text-decoration: none; color: var(--brand-orange-logo); }
  .rule-table { width: min(16rem, 80%); margin: 1.4rem 0 0 auto; padding: .5rem .8rem .7rem; background: var(--h-bg); color: var(--h-text); }
  .t-title { margin: 0 0 .3rem; font-family: var(--font-display); font-weight: 700; font-size: 1.1rem; color: var(--h-title); }
  .rule-table table { width: 100%; border-collapse: collapse; font-size: .92rem; background: var(--h-bg); }
  .rule-table th { text-align: left; padding: .35rem .2rem; border-top: 4px solid var(--h-title); border-bottom: 1px solid var(--h-title); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; color: var(--h-title); }
  .rule-table td { padding: .35rem .2rem; border-bottom: 1px solid var(--gray-33); font-variant-numeric: tabular-nums; }
  .rule-table tr:last-child td { border-bottom: 4px solid var(--h-title); }
  @media (max-width: 900px) { .hero-in { grid-template-columns: 1fr; } }
  /* Easter egg: click / Enter / Space on the code block runs it */
  .code-block { cursor: pointer; outline: none; transition: transform .15s; }
  .code-block:has(.hint:focus-visible) { box-shadow: 0 0 0 4px var(--h-bg), 0 0 0 8px var(--brand-blue); }
  @media (prefers-color-scheme: dark) { .code-block:has(.hint:focus-visible) { box-shadow: 0 0 0 4px var(--h-bg), 0 0 0 8px var(--brand-orange-logo); } }
  .file { display: flex; justify-content: space-between; gap: 1rem; }
  .hint { font: inherit; letter-spacing: .06em; text-transform: none; color: var(--gray-88); background: none; border: 0; padding: 0; cursor: pointer; outline: none; }
  .code-block:hover .hint, .hint:focus-visible { color: var(--white); text-decoration: underline; }
  .ln { display: block; min-height: 1.6em; }
  .out { margin: 0; padding: .55rem 1.1rem; min-height: 1.6em; border-top: 1px solid var(--gray-33); font-family: var(--font-mono); font-size: clamp(.66rem, 1vw, .82rem); line-height: 1.6; color: var(--gray-88); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .prompt { color: var(--brand-orange-logo); font-weight: 700; }
  [data-egg="done"] .res { color: var(--white); font-weight: 700; }
  .rule-table .you { visibility: hidden; }
  [data-egg="done"] .rule-table .you { visibility: visible; }
  [data-egg="done"] .rule-table .you td { background: var(--brand-orange-logo); color: var(--black); font-weight: 700; }
  @media (prefers-reduced-motion: no-preference) {
    [data-egg="running"] .ln { animation: type .3s steps(20, end) both; animation-delay: calc(var(--i) * 140ms); }
    [data-egg="done"] .rule-table .you td { animation: pop .5s ease-out; }
  }
  @keyframes type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes pop { from { background: var(--white); } }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

  /* Category blocks: adapt to 1-5 non-empty categories, never leave a hole */
  .cat-grid { list-style: none; padding: 0; margin: 0 0 3.5rem; display: grid; gap: 0; grid-template-columns: 1fr; }
  .cat-grid a { position: relative; display: flex; flex-direction: column; gap: .35rem; height: 100%; padding: 1.2rem 1.3rem 2.6rem; color: var(--text); text-decoration: none; background: var(--bg-soft); }
  .cat-grid li:nth-child(1) a { background: var(--brand-blue-logo); color: var(--white); padding-top: 1.6rem; }
  .cat-grid li:nth-child(2) a { background: var(--brand-orange-logo); color: var(--black); }
  .cat-grid li:nth-child(4) a { background: var(--surface); }
  .cat-grid .n { font-family: var(--font-display); font-weight: 700; font-size: 2.6rem; line-height: 1; letter-spacing: -0.03em; }
  .cat-grid li:nth-child(1) .n { font-size: clamp(4rem, 9vw, 7rem); }
  .cat-grid strong { font-family: var(--font-display); font-size: 1.15rem; } .cat-grid li:nth-child(1) strong { font-size: clamp(1.4rem, 2.6vw, 2rem); }
  .cat-grid .b { font-size: .9rem; } .cat-grid .go { position: absolute; right: 1.1rem; bottom: .8rem; font-size: 1.4rem; transition: transform .15s; }
  .cat-grid a:hover .go { transform: translateX(4px); } .cat-grid a:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .cat-grid[data-n="1"] li a { flex-direction: row; align-items: baseline; flex-wrap: wrap; column-gap: 1.5rem; }
  @media (min-width: 901px) {
    .cat-grid[data-n="2"] { grid-template-columns: 2fr 1fr; }
    .cat-grid[data-n="3"] { grid-template-columns: 2fr 1fr; } .cat-grid[data-n="3"] li:nth-child(1) { grid-row: span 2; }
    .cat-grid[data-n="4"] { grid-template-columns: 2fr 1fr 1fr; } .cat-grid[data-n="4"] li:nth-child(1) { grid-row: span 2; } .cat-grid[data-n="4"] li:nth-child(2) { grid-column: span 2; }
    .cat-grid[data-n="5"] { grid-template-columns: 2fr 1fr 1fr 1fr; } .cat-grid[data-n="5"] li:nth-child(1) { grid-row: span 2; } .cat-grid[data-n="5"] li:nth-child(2) { grid-column: span 3; }
  }
  @media (max-width: 900px) {
    .cat-grid:not([data-n="1"]) { grid-template-columns: 1fr 1fr; }
    .cat-grid li:nth-child(1), .cat-grid li:nth-child(2) { grid-column: 1 / -1; }
    .cat-grid li:last-child:nth-child(odd):not(:nth-child(1)) { grid-column: 1 / -1; }
  }

  /* Sparse states */
  .feat { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 0; }
  .feat li { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 1.5rem; padding: 1.6rem 0 1.8rem; }
  .fn { font-family: var(--font-display); font-weight: 700; line-height: .85; letter-spacing: -0.05em; color: var(--link-strong); }
  .feat .cat { font-weight: 700; color: var(--link); text-decoration: none; text-transform: uppercase; letter-spacing: .06em; font-size: .78rem; }
  .feat h3 { margin: .3rem 0 .6rem; line-height: 1.08; letter-spacing: -0.025em; } .feat h3 a { color: var(--text); text-decoration: none; } .feat h3 a:hover { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 4px; text-underline-offset: 6px; }
  .fd { margin: 0 0 1rem; max-width: 60ch; font-size: 1.08rem; }
  .feat-1 li { border-bottom: 6px solid var(--text); } .feat-1 .fn { font-size: clamp(5rem, 14vw, 11rem); } .feat-1 h3 { font-size: clamp(1.8rem, 4.5vw, 3.4rem); }
  .feat-2 { grid-template-columns: 1.6fr 1fr; column-gap: 2.5rem; border-bottom: 6px solid var(--text); }
  .feat-2 li { grid-template-columns: 1fr; } .feat-2 .fn { font-size: clamp(3.5rem, 8vw, 6rem); margin-bottom: .4rem; }
  .feat-2 li:nth-child(1) h3 { font-size: clamp(1.6rem, 3.4vw, 2.6rem); } .feat-2 li:nth-child(2) h3 { font-size: clamp(1.2rem, 2vw, 1.5rem); }
  .feat-2 li:nth-child(2) { padding-left: 1.5rem; border-left: 1px solid var(--muted); } .feat-2 li:nth-child(2) .fn { color: var(--text); }
  @media (max-width: 760px) { .feat-1 li { grid-template-columns: 1fr; } .feat-2 { grid-template-columns: 1fr; } .feat-2 li:nth-child(2) { padding-left: 0; border-left: 0; border-top: 1px solid var(--muted); } }
  .soon { display: grid; grid-template-columns: auto minmax(0, 1fr); column-gap: 2rem; padding: 2rem 1.5rem; margin-bottom: 2rem; background: var(--bg-soft); border-top: 6px solid var(--brand-orange-logo); }
  .soon-k { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: clamp(4rem, 12vw, 8rem); line-height: .85; letter-spacing: -0.05em; color: var(--link-strong); }
  .soon-t { margin: 0 0 .5rem; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem, 3.5vw, 2.4rem); line-height: 1.1; }
  .soon-links { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  @media (max-width: 560px) { .soon { grid-template-columns: 1fr; } }
</style>
